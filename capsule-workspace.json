{
  "kind": "capsule/workspace",
  "name": "Capsule Workspace",
  "projections": [
    {
      "adoptionPolicy": "none",
      "path": "Capsule Base",
      "role": "capsule-base",
      "verify": "capsule-base-body"
    },
    {
      "adoptionPolicy": "none",
      "path": "Capsule Generator",
      "role": "capsule-generator",
      "verify": "capsule-generator-body"
    },
    {
      "adoptionPolicy": "required",
      "path": "Capsule Directory",
      "role": "capsule-directory",
      "verify": "projection-body"
    },
    {
      "adoptionPolicy": "required",
      "path": "Capsule Updater",
      "role": "capsule-updater",
      "verify": "capsule-updater-body"
    },
    {
      "adoptionPolicy": "required",
      "path": "Capsule OS",
      "role": "capsule-os",
      "verify": "capsule-os-body"
    }
  ],
  "version": 1
}
